# Postgres connection string. Works with Supabase, RDS, neon, self-hosted, etc.
# Supabase: Project Settings → Database → Connection string (session mode is fine).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# LP Agent API key. Only needed if you wire the executor in entryExecute.ts
# to call executeZapCopyOpen against LP Agent (see agent-v2/README.md).
LP_AGENT_API_KEY=
