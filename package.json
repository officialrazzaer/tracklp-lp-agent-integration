{
  "name": "@tracklp/lp-agent-integration",
  "version": "0.1.0",
  "description": "TrackLP's LP Agent + Zap integration code, extracted as a technical case study for the LP Agent hackathon.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "lint": "tsc --noEmit -p tsconfig.json",
    "agent-v2:typecheck": "tsc --noEmit -p agent-v2/tsconfig.json",
    "agent-v2:rank:prepare": "tsx --env-file=.env agent-v2/rankPrepare.ts",
    "agent-v2:rank:apply": "tsx --env-file=.env agent-v2/rankApply.ts",
    "examples:typecheck": "tsc --noEmit -p examples/tsconfig.json",
    "examples:entry-tick": "tsx --env-file=.env examples/runEntryTick.example.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/officialrazzaer/tracklp-lp-agent-integration.git"
  },
  "homepage": "https://tracklp.com",
  "keywords": [
    "solana",
    "meteora",
    "dlmm",
    "lp-agent",
    "zap",
    "defi"
  ],
  "peerDependencies": {
    "@solana/web3.js": "^1.91.0"
  },
  "peerDependenciesMeta": {
    "@solana/web3.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solana/web3.js": "^1.91.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "jest": "^29.7.0",
    "pg": "^8.20.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.4.3"
  }
}
